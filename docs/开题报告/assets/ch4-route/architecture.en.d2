# Figure 4 — DeFuzz overall architecture (English)
# render: d2 --layout=elk --pad=24 architecture.en.d2 architecture.en.svg

direction: down

route: "DeFuzz Technical Route" {
  grid-rows: 2
  style: {
    fill: "#FFFFFF"; stroke: "#9CA3AF"; stroke-width: 1
    font-color: "#374151"; border-radius: 12; font-size: 22
  }

  offline: "Offline Knowledge Construction (Cross-Compiler-Backend)" {
    grid-columns: 3
    style: {
      fill: "#FAFAFA"; stroke: "#D1D5DB"; stroke-width: 1
      stroke-dash: 3; font-color: "#6B7280"; border-radius: 12; font-size: 22
    }

    corpus: "Research Corpus\nsource comments · official docs\nconfirmed historical bugs" {
      shape: cylinder
      style: {
        fill: "#F4F8FB"; stroke: "#6B7280"; stroke-width: 2
        font-color: "#374151"; bold: true; font-size: 22
      }
    }

    mining: "LLM Candidate Mining (Review Required)" {
      grid-rows: 2
      style: {
        fill: "#FFFFFF"; stroke: "#9CA3AF"; stroke-width: 1
        stroke-dash: 3; font-color: "#6B7280"; border-radius: 12; font-size: 22
      }

      cot: "Segmented CoT Coarse Extraction\ndefense semantics · candidate constraints" {
        style: {
          fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2
          font-color: "#0D47A1"; border-radius: 8; font-size: 22
        }
      }

      rag: "Historical-Bug RAG\ncross-compiler-backend generalization" {
        style: {
          fill: "#EDE7F6"; stroke: "#5E35B1"; stroke-width: 2
          font-color: "#311B92"; border-radius: 8; font-size: 22
        }
      }
    }

    library: "Invariant Candidate Library\npending human / deterministic review" {
      shape: cylinder
      style: {
        fill: "#FFF8E1"; stroke: "#F5A623"; stroke-width: 3
        font-color: "#7D4E00"; bold: true; font-size: 22
      }
    }
  }

  # Reverse ordering creates a two-row snake: down into checkers, then right-to-left.
  online: "Online Verification & Discovery (Checker → ISA)" {
    grid-columns: 4
    style: {
      fill: "#FAFAFA"; stroke: "#D1D5DB"; stroke-width: 1
      stroke-dash: 3; font-color: "#6B7280"; border-radius: 12; font-size: 22
    }

    findings: "Reproducible Defect Candidates\ndeterministic checker evidence\n+ minimized PoCs · auditable traces\nconfirmed results feed the bug corpus" {
      shape: cylinder
      style: {
        fill: "#E3F1E7"; stroke: "#228833"; stroke-width: 3
        font-color: "#195C24"; bold: true; font-size: 22
      }
    }

    agent_loop: "Agent Loop\nGenerator · Feedback · Minimizer\ndeterministic Build / Checker" {
      style: {
        fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 3
        font-color: "#0D47A1"; border-radius: 8; bold: true; font-size: 22
      }
    }

    scheduler: "Pair Scheduler\nlocks an Invariant–Checker Pair\nexpands ISAs from checker metadata" {
      style: {
        fill: "#F4DFD8"; stroke: "#CC3311"; stroke-width: 2
        font-color: "#7F2615"; border-radius: 8; font-size: 22
      }
    }

    checkers: "Deterministic Checkers" {
      grid-rows: 2
      style: {
        fill: "#FFFFFF"; stroke: "#9CA3AF"; stroke-width: 1
        stroke-dash: 3; font-color: "#6B7280"; border-radius: 12; font-size: 22
      }

      static: "Static Checkers\nassembly · ELF · binary properties" {
        style: {
          fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2
          font-color: "#0D47A1"; border-radius: 8; font-size: 22
        }
      }

      dynamic: "Dynamic Checkers\nexecution · instrumentation · cross-ISA diff" {
        style: {
          fill: "#E3F1E7"; stroke: "#228833"; stroke-width: 2
          font-color: "#195C24"; border-radius: 8; font-size: 22
        }
      }
    }
  }

  offline.corpus -> offline.mining.cot: { style: { stroke: "#1976D2"; stroke-width: 2 } }
  offline.corpus -> offline.mining.rag: { style: { stroke: "#5E35B1"; stroke-width: 2 } }
  offline.mining.cot -> offline.library: { style: { stroke: "#1976D2"; stroke-width: 2 } }
  offline.mining.rag -> offline.library: { style: { stroke: "#5E35B1"; stroke-width: 2 } }

  offline.library -> online.checkers.static: { style: { stroke: "#1976D2"; stroke-width: 2 } }
  offline.library -> online.checkers.dynamic: { style: { stroke: "#228833"; stroke-width: 2 } }
  online.checkers.static -> online.scheduler: { style: { stroke: "#1976D2"; stroke-width: 2 } }
  online.checkers.dynamic -> online.scheduler: { style: { stroke: "#228833"; stroke-width: 2 } }
  online.scheduler -> online.agent_loop: { style: { stroke: "#CC3311"; stroke-width: 2 } }
  online.agent_loop -> online.findings: { style: { stroke: "#228833"; stroke-width: 2 } }

  online.findings -> offline.corpus: {
    style: { stroke: "#6B7280"; stroke-width: 2; stroke-dash: 5 }
  }
}
