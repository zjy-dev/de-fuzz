# Fig: invariant -> checker -> grounded verdict (academic monochrome)
# render: d2 --theme=0 --pad=8 oracle-flow.d2 ../oracle-flow.svg

classes: {
  node:  { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  key:   { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  term:  { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A"; border-radius: 18 } }
  termE: { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A"; border-radius: 18 } }
}

direction: down

contract: "Accepted invariant → checker contract\npreconditions · signal · applicable ISAs · evidence" { class: key }
static: "Static checker\nsymbols · sections · disassembly" { class: node }
dynamic: "Dynamic checker\nexit status · register / memory" { class: node }
verdict: "Four-state verdict + reason / evidence\nPASS · FAIL · NOT APPLICABLE · ERROR" { class: key }
gate: "FAIL with reproducible deterministic signal?" { class: node; shape: diamond }
bug: "Report violated invariant\nwith evidence" { class: termE }
ok: "No reported violation\nretain diagnostics" { class: term }

contract -> static: "binary" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
contract -> dynamic: "execution" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
static -> verdict: "result" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
dynamic -> verdict: "result" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
verdict -> gate: "aggregate" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
gate -> bug: "yes" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
gate -> ok: "PASS / NA / ERROR" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
