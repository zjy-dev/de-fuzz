# Fig: versioned blackboard records every task state and result (academic monochrome)
# render: d2 --theme=0 --pad=8 blackboard.d2 ../blackboard.svg

classes: {
  actor: { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  bb:    { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  prop:  { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; font-color: "#333333" } }
}

direction: down

actors: "Orchestrator scheduler · Generator\nRouting / Build / Coverage / Checker\nFeedback · Minimizer + C-Reduce" { class: actor }

bb: "Versioned blackboard  (only linkage channel)\n\nlocked invariant–checker pair · applicable ISAs · budget\nseed corpus and lineage · routing/build artifacts · cumulative coverage\nfour-state verdict history · deterministic evidence · feedback guidance\nminimized PoC · revalidation result · review-ready finding record" { class: bb }

props: "REPRODUCIBLE  pin a version → inputs fixed\nABLATABLE  switch each linkage edge independently\nAUDITABLE  trace every claim to deterministic evidence" { class: prop }

actors -> bb: "all read/write through state; every result appended" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
bb -> props: "versioned replay · explicit edges · provenance" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
