# Fig: the blackboard - all inter-agent linkage via versioned shared state (academic monochrome)
# render: d2 --theme=0 --pad=8 blackboard.d2 ../blackboard.svg

classes: {
  agent: { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  bb:    { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  prop:  { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; font-color: "#333333" } }
}

direction: right

gen: "Generator" { class: agent; width: 130 }
feedback: "Feedback\nagent" { class: agent; width: 130 }
minim: "Minimizer" { class: agent; width: 130 }

bb: "Versioned blackboard  (shared state)\n\nseed corpus & lineage\ncumulative coverage\noracle verdict history\nfeedback guidance" { class: bb; width: 260 }

props: "" {
  grid-rows: 3
  grid-columns: 1
  grid-gap: 8
  style: { fill: transparent; stroke: transparent }
  reproduce: "Reproducible\npin a version -> agent input fully determined" { class: prop; width: 260 }
  ablate: "Ablatable\neach linkage edge switched off independently" { class: prop; width: 260 }
  audit: "Auditable\nbug claim traces back to deterministic cause" { class: prop; width: 260 }
}

gen -> bb: "read / write" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
feedback -> bb: "read / write" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
minim -> bb: "read / write" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
bb -> props.reproduce: "" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4 } }
bb -> props.ablate: "" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4 } }
bb -> props.audit: "" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4 } }
