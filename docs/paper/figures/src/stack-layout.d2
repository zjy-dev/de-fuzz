# Fig: CVE-2023-4039 buggy AArch64 stack-frame layout (academic monochrome)
# render: d2 --theme=0 --pad=8 stack-layout.d2 ../stack-layout.pdf

vars: {
  d2-config: {
    theme-id: 0
  }
}

classes: {
  plain: {
    style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" }
  }
  emph: {
    style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" }
  }
  note: {
    style: { fill: transparent; stroke: transparent; font-color: "#555555"; italic: true }
  }
  addr: {
    style: { fill: transparent; stroke: transparent; font-color: "#555555"; italic: true }
  }
}

direction: down

outer: "" {
  grid-rows: 3
  grid-columns: 1
  grid-gap: 10
  style: { fill: transparent; stroke: transparent }

  hi: "high address" { width: 440; height: 20; class: addr }

  frame: "" {
    grid-rows: 7
    grid-columns: 2
    grid-gap: 10
    style: { fill: transparent; stroke: transparent }

    incoming: "incoming stack args" { width: 230; height: 44; class: plain }
    incoming-note: "" { width: 1; height: 1; style: { fill: transparent; stroke: transparent } }

    canary: "stack canary" { width: 230; height: 44; class: emph }
    canary-note: "checked at epilogue" { width: 200; height: 44; class: note }

    locals: "local variables" { width: 230; height: 44; class: plain }
    locals-note: "frame_pointer_rtx" { width: 200; height: 44; class: note }

    retaddr: "saved return address (LR')" { width: 230; height: 44; class: emph }
    retaddr-note: "clobbered before canary" { width: 200; height: 44; class: note }

    fpsve: "FP' / SVE registers" { width: 230; height: 44; class: plain }
    fpsve-note: "" { width: 1; height: 1; style: { fill: transparent; stroke: transparent } }

    vla: "VLA buffer" { width: 230; height: 44; class: emph }
    vla-note: "overflow origin (grows up)" { width: 200; height: 44; class: note }

    outgoing: "outgoing stack args" { width: 230; height: 44; class: plain }
    outgoing-note: "" { width: 1; height: 1; style: { fill: transparent; stroke: transparent } }
  }

  lo: "low address  (stack grows down)" { width: 440; height: 20; class: addr }
}
