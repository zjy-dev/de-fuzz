# Fig: one locked-target agentic iteration (academic monochrome)
# render: d2 --theme=0 --pad=8 main-loop.d2 ../main-loop.svg

classes: {
  node:  { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  agent: { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  state: { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; font-color: "#333333" } }
  term:  { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A"; border-radius: 18 } }
  key:   { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
}

direction: down

target: "Orchestrator locks one invariant–checker pair\n+ applicable ISAs + budget" { class: key }
gen: "Generator agent\nseed for the locked invariant only" { class: agent }
spine: "Deterministic spine\nrouting → build → coverage → static / dynamic checker\n→ four-state verdict + evidence" { class: node }
route: "FAIL + deterministic evidence?" { class: node; shape: diamond }
feedback: "Feedback agent\nwrite coverage/verdict guidance → next round" { class: agent }
minim: "Minimizer + C-Reduce\nreduce → rebuild → same-checker revalidate" { class: agent }
next: "Continue locked target; then next pair" { class: term }
poc: "Revalidated minimized PoC\n→ human review" { class: term }
bb: "Versioned blackboard\nappend target, seeds, coverage, verdict/evidence,\nguidance, reduction, and revalidation" { class: state }

target -> gen: "assigned target" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
gen -> spine: "seed only" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
spine -> route: "verdict" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
route -> feedback: "PASS / NA / ERROR\n(Error retained as diagnostic)" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
route -> minim: "yes" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
feedback -> next: "persist" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
next -> gen: "next round" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
minim -> poc: "fixed point + same-checker FAIL" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
spine -> bb: "append deterministic state" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
feedback -> bb: "guidance" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
minim -> bb: "reduction / recheck" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
