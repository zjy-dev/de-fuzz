# Fig: checker-bound ISA routing (academic monochrome)
# render: d2 --theme=0 --pad=8 checker-routing.d2 ../checker-routing.svg

classes: {
  agent:  { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  checker:{ style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  always: { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; font-color: "#333333" } }
  isa:    { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
}

direction: right

agent: "Generator agent\nselects a checker superset\n('which checkers can\nthis seed trigger?')" { class: agent }

cA: "Checker A (differential)\nbinds {x86-64, AArch64, RISC-V}" { class: checker }
cB: "Checker B (single-ISA)\nbinds {AArch64}" { class: checker }
cheap: "Cheap static checkers\nalways on, not routed" { class: always }

x86: "x86-64" { class: isa }
arm: "AArch64" { class: isa }
rv: "RISC-V" { class: isa }

agent -> cA: "select" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
agent -> cB: "select" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }

cA -> x86: "fan-out (forced)" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
cA -> arm: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
cA -> rv: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
cB -> arm: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
cheap -> x86: "always" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
cheap -> arm: "" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4 } }
cheap -> rv: "" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4 } }
