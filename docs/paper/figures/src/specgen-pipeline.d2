# Fig: SpecGen pipeline distill -> analogy -> specialize -> entailment (academic monochrome)
# render: d2 --theme=0 --pad=8 specgen-pipeline.d2 ../specgen-pipeline.svg

classes: {
  io:   { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  step: { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  gate: { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  out:  { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
}

direction: down

seed: "Confirmed root cause (one mechanism)" { class: io }
distill: "distill:  mechanism-agnostic failure-mode description" { class: step }
analogy: "analogy  [semantic-isomorphism gate]" { class: gate }
specialize: "specialize:  instantiate on concrete target source" { class: step }
entailment: "entailment  [statement follows from evidence]" { class: gate }
inv: "New cross-mechanism invariant" { class: out }

corpus: "RAG corpus: 4,496 GCC-16.1 chunks" { class: io }

seed -> distill: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
distill -> analogy: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
corpus -> analogy: "retrieve\n(~94% lexical collisions rejected here)" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
analogy -> specialize: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
specialize -> entailment: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
entailment -> inv: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
