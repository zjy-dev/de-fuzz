# Fig: DeFuzz end-to-end technical route (academic monochrome, wide/figure*)
# render: d2 --theme=0 --pad=8 architecture.d2 ../architecture.svg

classes: {
  stage: { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  key:   { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
}

route: "" {
  style: { fill: transparent; stroke: transparent }
  grid-rows: 2
  grid-columns: 2
  grid-gap: 18

  discovery: "1  INVARIANT GENERATION\n\nSegmented CoT review: large corpus → candidates\nHistorical-bug RAG: root-cause homologues\nacross middle-end and target backends\n→ grounded, generalized invariants" { class: stage; width: 500; height: 210 }

  oracle: "2  CHECKER CONSTRUCTION\n\nInvariant → static / dynamic checker\nApplicable-ISA metadata\nFour-state verdict + deterministic evidence\nPASS · FAIL · NOT APPLICABLE · ERROR" { class: key; width: 500; height: 210 }

  loop: "3  AGENT LOOP\n\nOrchestrator locks one invariant–checker pair\n+ applicable ISAs + budget; Generator builds its seed\nrouting → build → coverage → checker\nFeedback or C-Reduce + same-checker revalidation" { class: stage; width: 500; height: 210 }

  state: "EVIDENCE AND FEEDBACK\n\nEvery state and result → versioned blackboard\nRevalidated violation → minimized PoC\nConfirmed new finding, including a zero-day\n→ next campaign's probe corpus" { class: stage; width: 500; height: 210 }
}

route.discovery -> route.oracle: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
route.oracle -> route.loop: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
route.loop -> route.state: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
route.state -> route.discovery: "confirmed root cause" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
