vars: {
  d2-config: {
    theme-id: 0
    layout-engine: elk
    pad: 12
  }
}
style.fill: "#FFFFFF"
classes: {
  main: {
    style: {
      fill: "#E8F5E9"
      stroke: "#1B5E20"
      stroke-width: 2
      font-color: "#1B5E20"
      font-size: 30
      bold: true
      border-radius: 12
    }
  }
  focus: {
    style: {
      fill: "#1B5E20"
      stroke: "#1B5E20"
      font-color: "#FFFFFF"
      font-size: 30
      bold: true
      border-radius: 12
    }
  }
  neutral: {
    style: {
      fill: "#F5F5F5"
      stroke: "#9E9E9E"
      font-color: "#333333"
      font-size: 28
      border-radius: 8
    }
  }
  yellow: {
    style: {
      fill: "#FFF8E1"
      stroke: "#D8A000"
      font-color: "#1B5E20"
      font-size: 28
      border-radius: 10
    }
  }
  danger: {
    style: {
      fill: "#FFEBEE"
      stroke: "#C62828"
      stroke-width: 2
      font-color: "#C62828"
      font-size: 28
      bold: true
      border-radius: 10
    }
  }
  edge: {
    style: {stroke: "#1B5E20"; stroke-width: 3; font-size: 25; font-color: "#555555"}
  }
  quiet: {
    style: {fill: transparent; stroke: transparent; font-size: 25; font-color: "#666666"}
  }
}
