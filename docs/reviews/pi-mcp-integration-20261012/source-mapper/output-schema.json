{"$defs": {"CriticalCondition": {"properties": {"expression": {"title": "Expression", "type": "string"}, "file": {"title": "File", "type": "string"}, "line": {"title": "Line", "type": "integer"}, "role": {"title": "Role", "type": "string"}}, "required": ["expression", "file", "line", "role"], "title": "CriticalCondition", "type": "object"}, "CriticalStruct": {"properties": {"name": {"title": "Name", "type": "string"}, "file": {"title": "File", "type": "string"}, "line": {"title": "Line", "type": "integer"}, "role": {"title": "Role", "type": "string"}}, "required": ["name", "file", "line", "role"], "title": "CriticalStruct", "type": "object"}, "PassAnchor": {"properties": {"name": {"title": "Name", "type": "string"}, "file": {"title": "File", "type": "string"}, "line_start": {"title": "Line Start", "type": "integer"}, "line_end": {"title": "Line End", "type": "integer"}, "evidence": {"title": "Evidence", "type": "string"}}, "required": ["name", "file", "line_start", "line_end", "evidence"], "title": "PassAnchor", "type": "object"}, "TargetFunction": {"properties": {"name": {"title": "Name", "type": "string"}, "file": {"title": "File", "type": "string"}, "line": {"title": "Line", "type": "integer"}, "role": {"title": "Role", "type": "string"}}, "required": ["name", "file", "line", "role"], "title": "TargetFunction", "type": "object"}}, "description": "Structured output from the source-mapper subagent.\n\nA single result maps ONE invariant onto Level 1 (pass), Level 2 (target\nfunctions), Level 3 (critical structs + gate conditions) of the compiler\nsource tree. Downstream, the log-instrumentation stage will attach\n``DEFUZZ_LOG(\"<mechanism>#<uid>:hit\", ...)`` calls at the cited lines.", "properties": {"phi_id": {"title": "Phi Id", "type": "string"}, "compiler": {"enum": ["gcc", "llvm", "clang"], "title": "Compiler", "type": "string"}, "isa": {"anyOf": [{"enum": ["x86_64", "aarch64", "riscv64", "loongarch64"], "type": "string"}, {"type": "null"}], "default": null, "title": "Isa"}, "mapping_confidence": {"enum": ["high", "medium", "low"], "title": "Mapping Confidence", "type": "string"}, "level_1_pass": {"$ref": "#/$defs/PassAnchor"}, "level_2_functions": {"items": {"$ref": "#/$defs/TargetFunction"}, "maxItems": 5, "title": "Level 2 Functions", "type": "array"}, "level_3_critical_structs": {"items": {"$ref": "#/$defs/CriticalStruct"}, "maxItems": 5, "title": "Level 3 Critical Structs", "type": "array"}, "level_3_critical_conditions": {"items": {"$ref": "#/$defs/CriticalCondition"}, "maxItems": 8, "title": "Level 3 Critical Conditions", "type": "array"}, "evidence_paths": {"items": {"type": "string"}, "title": "Evidence Paths", "type": "array"}, "unresolved_notes": {"description": "Gaps the agent could not resolve with read/grep alone; a future call-graph MCP tool will fill these.", "items": {"type": "string"}, "title": "Unresolved Notes", "type": "array"}}, "required": ["phi_id", "compiler", "mapping_confidence", "level_1_pass"], "title": "SourceMappingResult", "type": "object"}