{
  "$schema": "https://opencode.ai/config.json",
  // Rev 3: online defuzz agents live in `.opencode/agents/*.md`. The offline
  // source-mapper is currently under `.opencode/agent/source-mapper.md`
  // (singular) and is picked up automatically.
  //
  "mcp": {
    "defuzz-callgraph": {
      "type": "local",
      "command": ["./scripts/run_callgraph_mcp.sh"],
      "enabled": true
    }
  }

  // TODO(mcp): once the Go core MCP server exposes tool endpoints,
  // wire it in here so the seed-generator / feedback-analyzer / llm-oracle
  // subagents can call `defuzz-core_query_invariants`, `_coverage_diff`,
  // `_search_source`, `_compile_exec`, `_creduce_run` directly. Until
  // then, the IterationLoop pre-fetches all needed data and injects
  // it into the subagent prompt.
  //
  // "mcp": {
  //   "defuzz-core": {
  //     "type": "local",
  //     "command": ["./scripts/defuzz-core-mcp.sh"]
  //   }
  // }
  //
  // TODO(provider): default provider/model is picked up from env vars
  // (OPENAI_API_KEY / ANTHROPIC_API_KEY / ...) at runtime. For per-agent
  // model overrides, set `model:` in the corresponding markdown frontmatter.
}
